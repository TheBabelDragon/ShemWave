{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebabeldragon.github.io/ShemWave/schemas/presets.schema.json",
  "title": "ShemWave presets",
  "type": "object",
  "required": ["presets"],
  "properties": {
    "version": { "type": "string" },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "params"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "params": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
