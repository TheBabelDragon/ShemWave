{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebabeldragon.github.io/ShemWave/schemas/triplets.schema.json",
  "title": "ShemWave triplets",
  "type": "object",
  "required": ["triplets"],
  "properties": {
    "version": { "type": "string" },
    "source": { "type": "string" },
    "notes": { "type": "string" },
    "triplets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["letters"],
        "properties": {
          "id": { "type": "string" },
          "letters": { "type": "string", "minLength": 3, "maxLength": 3 },
          "display": { "type": "string" },
          "source_index": { "type": "integer", "minimum": 0 },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
